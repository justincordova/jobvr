{
  "name": "@jobvr/api",
  "version": "0.1.0",
  "description": "jobvr API, SPA host, and scheduler",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../.env --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@hono/zod-openapi": "^1.6.3",
    "@jobvr/core": "workspace:*",
    "@jobvr/poller": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.19",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "hono-pino": "^0.10.3",
    "hono-rate-limiter": "^0.5.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
