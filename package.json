{
  "name": "jobvr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @jobvr/api dev",
    "dev:web": "pnpm --filter @jobvr/web dev",
    "build": "pnpm --filter @jobvr/api build && pnpm --filter @jobvr/web build",
    "typecheck": "pnpm --filter @jobvr/api build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "prepare": "husky || true",
    "fix": "biome check --write . && pnpm --filter @jobvr/web format",
    "poll": "pnpm --filter @jobvr/poller poll",
    "seed": "pnpm --filter @jobvr/poller seed",
    "notify": "pnpm --filter @jobvr/poller notify",
    "discover": "pnpm --filter @jobvr/poller discover"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
