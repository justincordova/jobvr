# App (API + scheduler)
APP_NAME=jobvr
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0

# CORS allowlist (exact origins, comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000

# Set to true only when running behind exactly one trusted reverse proxy
TRUST_PROXY=false

# Request timeout in milliseconds (responds 503 when exceeded)
REQUEST_TIMEOUT_MS=30000

# Database (docker-compose.dev.yml)
DATABASE_URL=postgres://jobvr:jobvr@localhost:5432/jobvr

# Push: full ntfy topic URL with a long random topic (keep secret)
NTFY_URL=
# Push click target, e.g. https://jobvr.<tailnet>.ts.net
PUBLIC_URL=http://localhost:5173

AUTH_MODE=none
SCHEDULER_ENABLED=false

# Tailscale auth key (docker-compose.yml only)
TS_AUTHKEY=
