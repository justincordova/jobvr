# App (API + scheduler)
APP_NAME=jobvr
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# 0.0.0.0 to reach dev from your phone on the same Wi-Fi (no login: anyone there can too)
HOST=127.0.0.1

# CORS allowlist (exact origins, comma-separated). Mac dev only: docker-compose.yml empties it
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000

# Set to true only when running behind exactly one trusted reverse proxy
TRUST_PROXY=false

# Request timeout in milliseconds (responds 503 when exceeded)
REQUEST_TIMEOUT_MS=30000

# Database. Mac dev: docker-compose.dev.yml. PC: compose builds DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://jobvr:jobvr@localhost:5432/jobvr
# PC only. Letters and digits only (it goes into a URL unescaped): openssl rand -hex 32
# Read once, when the database volume is created (see README to change it later)
POSTGRES_PASSWORD=
# PC only: the app's log level in docker-compose.yml (default info)
# PC_LOG_LEVEL=info

# Push: full ntfy topic URL with a long random topic (keep secret)
NTFY_URL=
# Optional: rates new companies' tiers (S/A/B/C/D) with OpenAI (keep secret).
# About $0.0003 a company, at most 200 a day. Unset: new companies start as C tier, unrated.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Push click target, e.g. https://jobvr.<tailnet>.ts.net
PUBLIC_URL=http://localhost:5173

AUTH_MODE=none
SCHEDULER_ENABLED=false

# Tailscale auth key (docker-compose.yml only)
TS_AUTHKEY=
# Backup folder on the PC (docker-compose.yml only), e.g. a OneDrive folder
BACKUP_DIR=./backups
